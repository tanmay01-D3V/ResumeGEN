# ---------------------------------------------------------------------------
# ResumeGEN — environment template. Copy to .env and fill in real values.
# NEVER commit .env, service-account.json or private keys.
# ---------------------------------------------------------------------------

# Server
PORT=5050
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Authentication
# auto: use Firebase when Admin credentials are present, otherwise local demo auth
# true: always use local demo auth (useful for offline marking/demo)
# false: always require Firebase
DEMO_MODE=auto
# Required for demo session tokens in production. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=replace_with_a_long_random_string

# Local store used only in demo mode (Firestore is used when Firebase is configured)
DB_FILE=./Backend/.data/db.json

# Gemini (server-side only — never put this in Frontend/.env)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=30000

# Firebase Admin (server-side). Use a service-account JSON file with ADC:
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json
# Or provide the three values directly:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# The same service-account file is used for Google Sheets (Sheets API enabled).

# Google Sheets
# Create a spreadsheet, share it with the service-account email, then paste its ID.
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id

# ---------------------------------------------------------------------------
# Frontend Firebase client configuration (also set in Frontend/.env)
# These values are PUBLIC identifiers, not secrets. Firestore rules and the
# backend still enforce authorization.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# ---------------------------------------------------------------------------
